# Copy to aquatic-twin/.env. Never commit real keys.
# mock needs no key. Other options: gemini, anthropic, xai.
LLM_PROVIDER=mock
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
XAI_API_KEY=
# Live analysis commentary: local (default, no calls), gemini, or xai (placeholder, not connected)
ANALYST_PROVIDER=local
